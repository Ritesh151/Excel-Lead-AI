# ─── Server ───────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ─── MongoDB ──────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/ai_calling
MONGO_DB_NAME=ai_calling
MONGO_COLLECTION_CALLS=call_records
MONGO_MAX_POOL_SIZE=10
MONGO_MIN_POOL_SIZE=1
MONGO_RETRY_WRITES=true
MONGO_RETRY_READS=true
MONGO_RETRY_MAX_ATTEMPTS=3
MONGO_RETRY_DELAY_MS=500

# ─── Paths ────────────────────────────────────────────────────────────────────
LEADS_FILE_PATH=../leads/leads.xlsx
AUDIO_DIR=../audio
RECORDINGS_DIR=../recordings

# ─── ADB ──────────────────────────────────────────────────────────────────────
# Leave blank to auto-detect the first connected device
ADB_DEVICE_SERIAL=

# ─── Audio Playback ───────────────────────────────────────────────────────────
# Master volume: 0.0 (silent) to 1.0 (full). Default: 1.0
AUDIO_VOLUME=1.0
# sounddevice output device index. -1 = system default
AUDIO_OUTPUT_DEVICE=-1

# ─── Recording ────────────────────────────────────────────────────────────────
# How long to record caller response (seconds)
RECORDING_DURATION=5.0
# Sample rate in Hz — 16000 is optimal for speech / Whisper
RECORDING_SAMPLE_RATE=16000
# 1 = mono (recommended), 2 = stereo
RECORDING_CHANNELS=1
# sounddevice input device index. -1 = system default microphone
RECORDING_INPUT_DEVICE=-1
# Apply noise gate before saving (true/false)
RECORDING_NOISE_REDUCTION=false
# RMS silence threshold 0.0–1.0 (frames below this are considered silent)
RECORDING_SILENCE_THRESHOLD=0.01
# Minimum fraction of speech frames for a non-empty recording (0.0–1.0)
RECORDING_MIN_SPEECH_RATIO=0.05

# ─── Call Flow ────────────────────────────────────────────────────────────────
# Audio file names (must exist in AUDIO_DIR)
CALL_FLOW_GREETING_FILE=greeting.wav
CALL_FLOW_THANK_YOU_FILE=thank_you.wav
# How many seconds to record caller response
CALL_FLOW_RECORDING_DURATION=5.0
# Seconds to wait between calls
CALL_FLOW_BETWEEN_CALLS_DELAY=3.0
# Max seconds to wait for call to connect
CALL_FLOW_CONNECT_TIMEOUT=60.0
# Max duration for an entire call (hangup safeguard)
CALL_FLOW_MAX_CALL_DURATION=120.0
# Number of dial retries per lead
CALL_FLOW_RETRY_ATTEMPTS=2
# Seconds between retry attempts
CALL_FLOW_RETRY_DELAY=10.0
# Set true to loop through leads continuously
CALL_FLOW_LOOP=false

# ─── Whisper ──────────────────────────────────────────────────────────────────
# Options: tiny | base | small | medium | large-v2 | large-v3
WHISPER_MODEL=base
# cpu or cuda (use cuda only if GPU + CUDA toolkit are present)
WHISPER_DEVICE=cpu
# int8 = fastest/lowest RAM, float16 = GPU, float32 = CPU high precision
WHISPER_COMPUTE_TYPE=int8
# Primary language hint: hi = Hindi, en = English (detects mixed speech)
WHISPER_LANGUAGE=hi
# Beam size: 1 = fastest, 5 = more accurate
WHISPER_BEAM_SIZE=3
# Voice activity detection — removes silence before transcribing (recommended)
WHISPER_VAD_FILTER=true
