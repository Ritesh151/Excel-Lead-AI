# ════════════════════════════════════════════════════════════════════
# BACKEND-NODE ENVIRONMENT CONFIGURATION
# Exotel-based Voice Calling Platform
# ════════════════════════════════════════════════════════════════════

# ─── Server ───────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── MongoDB ──────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/ai_calling
MONGODB_USER=
MONGODB_PASSWORD=

# ─── Exotel Configuration ─────────────────────────────────────────────
# Exotel account credentials
EXOTEL_SID=your_exotel_sid
EXOTEL_API_KEY=f126470652bca076c7728d552d94e15bb532b196fda11f2b
EXOTEL_API_TOKEN=136478c48bf752ed451b6ab34671ea5b0e6dfc2bb8ee5ccb
EXOTEL_CALLER_ID=09513886363
EXOTEL_BASE_URL=https://api.exotel.com/v1

# ─── Callback URLs ────────────────────────────────────────────────────
# Base URL for webhooks (use ngrok in development)
# Example for ngrok: https://abc123.ngrok.io
BASE_URL=http://localhost:3000

# ─── Audio Configuration ───────────────────────────────────────────────
# Root audio folder containing greeting.wav and telephony versions
AUDIO_DIR=../audio
# The telephony-optimized greeting audio file served to Exotel
AUDIO_FILE_NAME=greeting_telephony.wav

# ─── Local Development Options ──────────────────────────────────────────
# Set to true to allow localhost BASE_URL during development.
ALLOW_LOCAL_BASE_URL=true

# ─── Exotel Options ───────────────────────────────────────────────────
EXOTEL_MAX_RETRIES=3
EXOTEL_RETRY_DELAY=2000

# ─── Campaign Settings ────────────────────────────────────────────────
# Path to leads Excel file
LEADS_FILE_PATH=./leads/leads.xlsx

# Delay between calls (milliseconds)
CALL_DELAY_MS=2000

# Max calls per minute
MAX_CALLS_PER_MINUTE=10

# ─── Recordings ───────────────────────────────────────────────────────
RECORDINGS_DIR=./recordings

# Max retries for recording download
RECORDING_MAX_RETRIES=3
RECORDING_RETRY_DELAY=2000

# ─── AI Engine (Python FastAPI) ────────────────────────────────────────
# URL of Python FastAPI server for transcription
AI_ENGINE_URL=http://localhost:8000

# ─── Logging ──────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_DIR=./logs

# ─── Session Settings ─────────────────────────────────────────────────
SESSION_SECRET=your_session_secret_key

# ─── Rate Limiting ────────────────────────────────────────────────────
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# ─── CORS ─────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── Timeout Settings ─────────────────────────────────────────────────
# Timeouts in milliseconds
API_TIMEOUT_MS=30000
TRANSCRIPTION_TIMEOUT_MS=120000
