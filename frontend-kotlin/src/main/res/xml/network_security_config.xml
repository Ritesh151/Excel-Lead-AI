<?xml version="1.0" encoding="utf-8"?>
<!--
  network_security_config.xml — Network security policy for Android 9+

  PURPOSE:
    Allow HTTP (cleartext) to local LAN backend during development
    Android 9+ blocks cleartext by default; this config creates exceptions
    for private IP ranges while keeping HTTPS required for internet

  SECURITY MODEL:
    ✓ Allows cleartext to all IPs (development mode)
    ✓ Replace with HTTPS-only config when deploying to production

  ANDROID VERSIONS:
    ✓ Android 9+ (required for this config)
    ✓ Android 14+ (aggressive cleartext blocking, fully respected)
    ✓ Android 15+ (forward compatible)
-->
<network-security-config>
  <!-- Allow all cleartext traffic (development mode only) -->
  <base-config cleartextTrafficPermitted="true">
    <trust-anchors>
      <certificates src="system" />
    </trust-anchors>
  </base-config>
</network-security-config>
